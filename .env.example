# Required only for live translation. Use the provider's complete OpenAI-compatible
# Chat Completions endpoint and one of its model identifiers.
LLM_CHAT_COMPLETIONS_URL=https://provider.example/v1/chat/completions
LLM_MODEL=provider-model-name

# Optional authentication. These defaults produce: Authorization: Bearer <key>
# LLM_API_KEY=replace-me
# LLM_API_KEY_HEADER=Authorization
# LLM_API_KEY_SCHEME=Bearer

# Optional provider-specific headers as a JSON object.
# LLM_EXTRA_HEADERS={"X-Client":"parallel-book-viewer"}

# Optional generation and transport settings.
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=900
# TRANSLATION_TIMEOUT_SECONDS=90

